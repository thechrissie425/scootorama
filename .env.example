# Copy to .env.local and fill in. Never commit .env.local.

# --- Sanity (required) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-12-12
# Editor token for `npm run seed` and Studio actions
SANITY_API_TOKEN=
# Viewer token for draft mode and live preview (an Editor token also works locally)
SANITY_API_READ_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: standalone Studio (`npm run studio`) ---
# SANITY_STUDIO_PROJECT_ID=your-project-id
# SANITY_STUDIO_DATASET=production

# --- Optional: Shopify Storefront (server-side only; never prefix with NEXT_PUBLIC_) ---
# US_SHOPIFY_DOMAIN=
# US_SHOPIFY_TOKEN=
# UK_SHOPIFY_DOMAIN=
# UK_SHOPIFY_TOKEN=
# EU_SHOPIFY_DOMAIN=
# EU_SHOPIFY_TOKEN=

# --- Optional: AI translation ---
# OPENAI_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=

# --- Optional: Figma token sync ---
# FIGMA_ACCESS_TOKEN=
# FIGMA_FILE_KEY=

# --- Optional: seed art rendering ---
# CHROMIUM_PATH=
