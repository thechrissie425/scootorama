{
  "name": "scootorama",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:tokens",
    "dev": "next dev",
    "studio": "sanity dev",
    "seed": "tsx scripts/seed/index.ts",
    "seed:art": "python3 scripts/seed/art/scenes.py && node scripts/seed/art/render.mjs",
    "build": "npm run build:tokens && next build",
    "build:tokens": "node scripts/build-tokens.js",
    "tokens:sync": "tsx scripts/figma-tokens.ts",
    "tokens:check": "tsx scripts/figma-tokens.ts --check",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "typecheck:scripts": "tsc --noEmit --skipLibCheck scripts/**/*.ts",
    "check:brand": "node scripts/check-brand-leaks.mjs",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "validate": "tsx scripts/validate-content.ts",
    "validate:tasks": "tsx scripts/validate-content.ts --create-tasks",
    "validate:pre-deploy": "npm run validate && npm run typecheck && npm run build",
    "prepare": "husky",
    "postinstall": "tsc-files --noEmit",
    "generate:block": "tsx scripts/generate-block.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "seo:audit:tasks": "tsx scripts/seo-audit.ts --create-tasks",
    "translation:audit": "tsx scripts/translation-audit.ts",
    "translation:audit:tasks": "tsx scripts/translation-audit.ts --create-tasks",
    "structured-data:audit": "tsx scripts/structured-data-audit.ts",
    "structured-data:audit:tasks": "tsx scripts/structured-data-audit.ts --create-tasks",
    "prestorybook": "npm run build:tokens",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@actions/github": "^9.0.0",
    "@actions/http-client": "^4.0.0",
    "@formatjs/intl-localematcher": "^0.7.3",
    "@portabletext/react": "^4.0.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sanity/assist": "^5.0.3",
    "@sanity/color-input": "^6.0.3",
    "@sanity/document-internationalization": "^4.1.1",
    "@sanity/image-url": "^1.0.2",
    "@sanity/presentation": "^2.0.0",
    "@sanity/vision": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "negotiator": "^1.0.0",
    "next": "^16.1.1",
    "next-sanity": "^12.0.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sanity": "^5.5.0",
    "styled-components": "^6.1.19",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "undici": "^6.23.0",
    "web-vitals": "^5.1.0"
  },
  "resolutions": {
    "undici": "^6.23.0",
    "@actions/core": "^1.12.0",
    "@actions/http-client": "^4.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/nextjs-vite": "^10.1.11",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "^10.1.11",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "lint-staged": "^16.2.7",
    "mini-svg-data-uri": "^1.4.4",
    "playwright": "^1.57.0",
    "postcss": "^8.4.47",
    "prettier": "^3.7.4",
    "storybook": "^10.1.11",
    "style-dictionary": "^5.1.4",
    "svgo": "^4.0.0",
    "tailwindcss": "^3.4.13",
    "tsc-files": "^1.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^7.3.1",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.17"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
